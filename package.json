{
  "name": "@abap2ui5/mcp-server",
  "version": "0.3.0",
  "mcpName": "io.github.abap2UI5/mcp-server",
  "description": "MCP server for abap2UI5: capability queries, view validation, deploy, headless run + screenshot — the AI agent dev loop, no SAP system needed.",
  "type": "module",
  "bin": {
    "mcp-server": "server.mjs",
    "abap2ui5-mcp": "server.mjs",
    "abap2ui5-unit": "scripts/ci-unit.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "npm run check:server-json && npm test",
    "check:server-json": "node scripts/check-server-json.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "version": "node scripts/check-server-json.mjs --sync && git add server.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5/mcp-server.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5/mcp-server/issues"
  },
  "homepage": "https://github.com/abap2UI5/mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright": "^1.63.0"
  },
  "peerDependencies": {
    "@abap2ui5/linter": ">=0.8.0 <0.9.0",
    "@abap2ui5/linter-render": ">=0.8.0 <0.9.0"
  },
  "peerDependenciesMeta": {
    "@abap2ui5/linter-render": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "server.mjs",
    "lib/",
    "scripts/ci-unit.mjs",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "abap2ui5",
    "abap",
    "ui5",
    "mcp",
    "model-context-protocol",
    "sap"
  ]
}
